# Chuỗi kết nối PostgreSQL. Local: Postgres chạy trên máy; production: chuỗi kết nối Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_manager?schema=public"

# Đăng nhập (Auth.js + Google). Tạo AUTH_SECRET bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email Google duy nhất được vào app. Để trống = không ai vào được.
OWNER_EMAIL=""
